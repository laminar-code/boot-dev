#!/bin/sh
# Script to complete configuration of boot-dev
# Adding home-manager to container build causes
# an inordinate amount of build time

# Need to remove .bashrc and .profile to
# prevent conflict when home-manager takes over
# management of .bashrc and .profile
cp -p ~/.bashrc ~/.bashrc.orig
cp -p ~/.profile ~/.profile.orig
rm ~/.bashrc ~/.profile

# Install home-manager
nix-shell '<home-manager>' -A install

# Link to devenv flake
ln -s /home/$USER/git/boot-dev/nix/devenv /home/$USER/devenv

home-manager switch

# Install any missing plugins and pin every plugin to the commit recorded in
# boot-dev's lazy-lock.json. BOOT_DEV_LAZY_LOCKFILE_READONLY keeps lazy from
# rewriting the lock file while it is still discovering plugin specs.
# The bang makes Lazy wait until restore has finished.
BOOT_DEV_LAZY_LOCKFILE_READONLY=1 nvim --headless "+Lazy! restore" +qa

echo
echo
echo "System ready. Exit and start a new session."
