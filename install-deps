#!/usr/bin/env bash
set -euo pipefail

REPO_URL="${REPO_URL:-https://github.com/laminar-code/boot-dev.git}"
REPO_BRANCH="${REPO_BRANCH:-main}"
INSTALL_DIR="${INSTALL_DIR:-$HOME/boot-dev}"
PROMPT_VARS=(USERNAME GIT_UTILS_REPO GIT_UTILS_REPO_RAW GIT_BEARER_TOKEN GIT_USER_NAME GIT_USER_EMAIL HOME_NIX LOCAL_DIRECTORY)
REQUIRED_VARS=(USERNAME GIT_UTILS_REPO GIT_UTILS_REPO_RAW GIT_USER_NAME GIT_USER_EMAIL HOME_NIX LOCAL_DIRECTORY)

SRC_DIR="$(dirname "${BASH_SOURCE[0]:-}")"
SCRIPT_DIR="$(cd "$SRC_DIR" 2>/dev/null && pwd || true)"
BOOTSTRAP_DIR="$SCRIPT_DIR/nix/bootstrap"

if [ ! -d "$BOOTSTRAP_DIR" ]; then
  if [ -d "$INSTALL_DIR" ] && [ -n "$(ls -A "$INSTALL_DIR" 2>/dev/null)" ]; then
    echo "ERROR: $INSTALL_DIR exists and is not empty. Set INSTALL_DIR to a different location."
    exit 1
  fi
  echo "boot-dev sources not found locally; fetching to $INSTALL_DIR"
  mkdir -p "$INSTALL_DIR"
  if command -v git > /dev/null 2>&1; then
    git clone --quiet --branch "$REPO_BRANCH" "$REPO_URL" "$INSTALL_DIR"
  else
    curl -fsSL "https://github.com/laminar-code/boot-dev/archive/refs/heads/$REPO_BRANCH.tar.gz" | tar xz -C "$INSTALL_DIR" --strip-components=1
  fi
  SCRIPT_DIR="$INSTALL_DIR"
  BOOTSTRAP_DIR="$SCRIPT_DIR/nix/bootstrap"
fi

ENV_FILE="${ENV_FILE:-$BOOTSTRAP_DIR/.env}"

SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  SUDO="sudo"
fi

PM=""
if command -v apt-get > /dev/null 2>&1; then
  PM=apt
elif command -v dnf > /dev/null 2>&1; then
  PM=dnf
elif command -v yum > /dev/null 2>&1; then
  PM=yum
elif command -v pacman > /dev/null 2>&1; then
  PM=pacman
else
  echo "ERROR: Unsupported package manager."
  exit 1
fi

install_apt() {
  . /etc/os-release
  $SUDO apt-get -y update
  $SUDO apt-get -y install ca-certificates curl gnupg git jq util-linux-extra
  $SUDO install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "https://download.docker.com/linux/$ID/gpg" | $SUDO gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
  $SUDO chmod a+r /etc/apt/keyrings/docker.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $VERSION_CODENAME stable" | $SUDO tee /etc/apt/sources.list.d/docker.list > /dev/null
  $SUDO apt-get -y update
  $SUDO apt-get -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
}

install_dnf() {
  . /etc/os-release
  local pm=dnf
  if [ "$PM" = "yum" ]; then
    pm=yum
  fi
  $SUDO "$pm" -y install dnf-plugins-core curl git jq
  $SUDO "$pm" -y config-manager --add-repo "https://download.docker.com/linux/$ID/docker-ce.repo"
  $SUDO "$pm" -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
}

install_pacman() {
  $SUDO pacman -Sy --needed docker docker-buildx docker-compose git curl jq
}

if command -v docker > /dev/null 2>&1 \
  && docker compose version > /dev/null 2>&1 \
  && docker buildx version > /dev/null 2>&1; then
  echo "Docker with compose and buildx already available, skipping package install."
else
  case "$PM" in
    apt)
      install_apt
      ;;
    dnf|yum)
      install_dnf
      ;;
    pacman)
      install_pacman
      ;;
  esac
fi

if command -v systemctl > /dev/null 2>&1; then
  if ! systemctl is-active docker > /dev/null 2>&1 || ! systemctl is-enabled docker > /dev/null 2>&1; then
    $SUDO systemctl enable --now docker || echo "WARN: Could not enable/start docker via systemctl."
  fi
fi

ensure_newgrp() {
  if command -v newgrp > /dev/null 2>&1; then
    return 0
  fi
  echo "newgrp not found; installing it."
  case "$PM" in
    apt)
      $SUDO apt-get -y install login
      ;;
    dnf|yum)
      $SUDO "$PM" -y install shadow-utils
      ;;
    pacman)
      $SUDO pacman -S --needed shadow
      ;;
  esac
}

verify_docker_group() {
  if ! getent group docker > /dev/null 2>&1; then
    $SUDO groupadd docker
  fi
  if getent group docker 2>/dev/null | cut -d: -f4 | tr ',' '\n' | grep -qx "$USER"; then
    echo "User '$USER' is a member of the 'docker' group."
  else
    $SUDO usermod -aG docker "$USER"
    ensure_newgrp
    DOCKER_GROUP_ADDED=1
    echo "Added '$USER' to the 'docker' group. A shell with the 'docker' group will open when the script finishes."
  fi
}

verify_docker_group

trap 'if [ "${DOCKER_GROUP_ADDED:-0}" = 1 ]; then echo "Opening a new shell with the '\''docker'\'' group (type '\''exit'\'' to return)."; newgrp docker || true; fi' EXIT

mkdir -p "$BOOTSTRAP_DIR/.build/certs" "$BOOTSTRAP_DIR/.build/.ssh"
touch "$BOOTSTRAP_DIR/.build/certs/.placeholder" "$BOOTSTRAP_DIR/.build/.ssh/.placeholder"

prompt_var() {
  local var="$1"
  local current=""
  local default=""
  local value=""
  current="$(grep -E "^${var}=" "$ENV_FILE" | tail -n 1 | cut -d= -f2- | tr -d '"' || true)"
  case "$var" in
    USERNAME)           default="${USER:-$(id -un)}" ;;
    GIT_UTILS_REPO)     default="$REPO_URL" ;;
    GIT_UTILS_REPO_RAW) default="https://raw.githubusercontent.com/laminar-code/boot-dev/$REPO_BRANCH" ;;
    GIT_BEARER_TOKEN)   default="" ;;
    GIT_USER_NAME)      default="$(git config --get user.name 2>/dev/null || true)" ;;
    GIT_USER_EMAIL)     default="$(git config --get user.email 2>/dev/null || true)" ;;
    HOME_NIX)           default="https://raw.githubusercontent.com/laminar-code/boot-dev/$REPO_BRANCH/nix/home-manager/home.nix" ;;
    LOCAL_DIRECTORY)    default="$HOME/work" ;;
  esac
  if [ -z "$current" ] || printf '%s' "$current" | grep -q '<'; then
    current="$default"
  fi
  if [ -n "$current" ]; then
    read -r -p "  $var [$current]: " value < /dev/tty || true
  else
    read -r -p "  $var: " value < /dev/tty || true
  fi
  if [ -n "$value" ]; then
    sed -i "s|^${var}=.*|${var}=\"${value}\"|" "$ENV_FILE"
  elif [ -n "$current" ]; then
    sed -i "s|^${var}=.*|${var}=\"${current}\"|" "$ENV_FILE"
  elif [ "$var" = "GIT_BEARER_TOKEN" ]; then
    sed -i "s|^${var}=.*|${var}=\"\"|" "$ENV_FILE"
  fi
}

if [ ! -f "$ENV_FILE" ]; then
  cp "$BOOTSTRAP_DIR/.env.README" "$ENV_FILE"
  echo "Created $ENV_FILE from the documented template."
  if (exec 3<> /dev/tty) 2> /dev/null; then
    exec 3>&-
    echo "Enter values for the variables (press Enter to accept the default, token is optional):"
    for var in "${PROMPT_VARS[@]}"; do
      prompt_var "$var"
    done
  else
    echo "No interactive terminal detected; fill in $ENV_FILE manually."
  fi
else
  echo "$ENV_FILE already exists."
fi

missing=0
if grep -E "^GIT_BEARER_TOKEN=.*<" "$ENV_FILE" > /dev/null 2>&1; then
  sed -i 's|^GIT_BEARER_TOKEN=.*|GIT_BEARER_TOKEN=""|' "$ENV_FILE"
fi
for var in "${REQUIRED_VARS[@]}"; do
  value="$(grep -E "^${var}=" "$ENV_FILE" 2>/dev/null | tail -n 1 | cut -d= -f2- | tr -d '"' || true)"
  if [ -z "$value" ] || printf '%s' "$value" | grep -q '<'; then
    echo "  $var is unset or still a template placeholder."
    missing=1
  fi
done

if [ "$missing" -eq 1 ]; then
  echo
  echo "ERROR: Required variables in $ENV_FILE are missing. Edit the file and re-run this script."
  exit 1
fi

REL_BOOTSTRAP="$(realpath --relative-to "$PWD" "$BOOTSTRAP_DIR" 2>/dev/null || true)"
[ -n "$REL_BOOTSTRAP" ] || REL_BOOTSTRAP="$BOOTSTRAP_DIR"
echo
echo "Dependencies are in place."

answer="Y"
if (exec 3<> /dev/tty) 2> /dev/null; then
  exec 3>&-
  read -r -p "Run the build now? [Y/n]: " answer < /dev/tty || true
fi

case "$answer" in
  ""|[Yy]*)
    echo "Running: cd $BOOTSTRAP_DIR && ./build"
    (cd "$BOOTSTRAP_DIR" && ./build)
    ;;
  *)
    echo "Skipping. Next: cd $REL_BOOTSTRAP && ./build"
    ;;
esac
