#!/bin/sh
# Machine init to enable boot-dev build and execution

usage() {
  cat <<EOF
Usage: $0 [--user USER]

Provision this machine for boot-dev.

Options:
  --user USER  Account to configure (default: devx; prompts when omitted)
  -h, --help   Show this help
EOF
}

CONFIG_USER=""
while [ $# -gt 0 ]; do
  case "$1" in
    --user)
      if [ $# -lt 2 ]; then
        echo "error: --user requires a value" >&2
        usage >&2
        exit 1
      fi
      CONFIG_USER="$2"
      shift 2
      ;;
    --user=*)
      CONFIG_USER="${1#--user=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

# Prompt before doing anything else when --user was not supplied.
if [ -z "$CONFIG_USER" ]; then
  CONFIG_USER=devx
  if [ -t 0 ]; then
    printf 'Enter username for configuration [%s]: ' "$CONFIG_USER"
    read -r CONFIG_USER_INPUT || true
    if [ -n "$CONFIG_USER_INPUT" ]; then
      CONFIG_USER="$CONFIG_USER_INPUT"
    fi
  fi
fi
export CONFIG_USER

# Keep package management unattended: assume yes, keep existing config
# files on conffile conflicts, and stop needrestart from prompting.
apt_get() {
  sudo env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a \
    apt-get -yqq \
    -o Dpkg::Options::=--force-confdef \
    -o Dpkg::Options::=--force-confold \
    "$@"
}

apt_get update
apt_get upgrade

# Install nala for parallel downloads and updates
# then install base level required packages
apt_get install nala
sudo env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a nala install -y locales sudo make curl ca-certificates git unzip slirp4netns uidmap buildah xz-utils nano neovim gcc flatpak xdg-desktop-portal util-linux-extra
sudo nala clean --lists
sudo rm -rf /var/lib/apt/lists/*
sudo update-ca-certificates
sudo locale-gen en_US.UTF-8
sudo DEBIAN_FRONTEND=noninteractive dpkg-reconfigure -f noninteractive locales
sudo update-locale LANG="en_US.UTF-8" LANGUAGE="en_US"
# Remove the default ubuntu account and group when they exist; tolerate
# systems where they are already gone.
if id ubuntu >/dev/null 2>&1; then
  sudo userdel --remove --force ubuntu 2>/dev/null || true
fi
if getent group ubuntu >/dev/null 2>&1; then
  sudo groupdel ubuntu 2>/dev/null || true
fi

if ! id devx >/dev/null 2>&1; then
  sudo adduser --shell /usr/bin/bash --disabled-password --gecos "" devx
fi
if ! getent group devs >/dev/null 2>&1; then
  sudo groupadd -g 9999 devs || true
fi
sudo usermod -a -G devs devx
sudo usermod -aG sudo devx
printf '%s\n' "devx ALL=(ALL) NOPASSWD:ALL" | sudo tee /etc/sudoers.d/devx >/dev/null
sudo chmod 0440 /etc/sudoers.d/devx

sudo mkdir -p -m 0755 /nix
sudo chown devx:devx /nix -R

# Install gpg 2.4.9
curl -fsSL https://repos.gnupg.org/deb/gnupg/resolute-devel/gnupg-signing-key.gpg | sudo gpg --dearmor --yes -o /usr/share/keyrings/gnupg-keyring.gpg
sudo chmod a+r /usr/share/keyrings/gnupg-keyring.gpg
sudo tee /etc/apt/sources.list.d/gnupg.sources <<EOF
Types: deb deb-src
URIs: https://repos.gnupg.org/deb/gnupg/resolute-devel/
Suites: resolute
Components: main
Signed-By: /usr/share/keyrings/gnupg-keyring.gpg
EOF

apt_get update
apt_get install gnupg

# Install signal-cli
sudo curl -sL -o /etc/apt/trusted.gpg.d/morph027-signal-cli.asc https://packaging.gitlab.io/signal-cli/gpg.key
echo "deb https://packaging.gitlab.io/signal-cli signalcli main" | sudo tee /etc/apt/sources.list.d/morph027-signal-cli.list
apt_get update
apt_get install signal-cli-native
# signal-cli link -n "DevConsole" | xargs -L 1 qrencode -o signal_qr.png

set -euo pipefail

sudo -iu "${CONFIG_USER}" <<EOF
# Configure certs
# Place any local certs into ~/certs
mkdir ~/certs
# sudo copy ~/certs/*.crt /usr/local/share/ca-certificates/
# sudo update-ca-certificates

# Clone repos for dev config
mkdir /home/${CONFIG_USER}/git
cd /home/${CONFIG_USER}/git

# Boot dev
git clone https://github.com/laminar-code/boot-dev.git

# Download and install nerd fonts
mkdir -p ~/.local/share/fonts
curl -L https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.0/IBMPlexMono.zip -o /tmp/IBMPlexMono.zip
curl -L https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.0/JetBrainsMono.zip -o /tmp/JetBrainsMono.zip
unzip -o /tmp/IBMPlexMono.zip -d ~/.local/share/fonts
unzip -o /tmp/JetBrainsMono.zip -d ~/.local/share/fonts
fc-cache -f
rm /tmp/IBMPlexMono.zip /tmp/JetBrainsMono.zip

# Set up local scripts
mkdir /home/${CONFIG_USER}/bin
ln -s /home/${CONFIG_USER}/git/boot-dev/git/clone /home/${CONFIG_USER}/bin/clone
ln -s /home/${CONFIG_USER}/git/boot-dev/git/clone-files-only /home/${CONFIG_USER}/bin/clone-files-only
ln -s /home/${CONFIG_USER}/git/boot-dev/git/switch-origin /home/${CONFIG_USER}/bin/switch-origin
ln -s /home/${CONFIG_USER}/git/boot-dev/git/current-version /home/${CONFIG_USER}/bin/current-version
ln -s /home/${CONFIG_USER}/git/boot-dev/git/filter-repo /home/${CONFIG_USER}/bin/filter-repo
ln -s /home/${CONFIG_USER}/git/boot-dev/git/largest-files /home/${CONFIG_USER}/bin/largest-files
ln -s /home/${CONFIG_USER}/git/boot-dev/container/docker-ports /home/${CONFIG_USER}/bin/docker-ports
ln -s /home/${CONFIG_USER}/git/boot-dev/container/labels /home/${CONFIG_USER}/bin/labels
ln -s /home/${CONFIG_USER}/git/boot-dev/container/label-container /home/${CONFIG_USER}/bin/label-container
ln -s /home/${CONFIG_USER}/git/boot-dev/nix/bin/dev /home/${CONFIG_USER}/bin/dev
ln -s /home/${CONFIG_USER}/git/boot-dev/nix/bin/init /home/${CONFIG_USER}/bin/init
ln -s /home/${CONFIG_USER}/git/boot-dev/bin/get-secure-script /home/${CONFIG_USER}/bin/get-secure-script
ln -s /home/${CONFIG_USER}/git/boot-dev/bin/get-secure-file /home/${CONFIG_USER}/bin/get-secure-file

# Link base config directories to boot-dev
mkdir -p /home/${CONFIG_USER}/.config && ln -s /home/${CONFIG_USER}/git/boot-dev/nix/config /home/${CONFIG_USER}/.config/nix
mkdir -p /home/${CONFIG_USER}/.config && ln -s /home/${CONFIG_USER}/git/boot-dev/tmux /home/${CONFIG_USER}/.config/tmux
mkdir -p /home/${CONFIG_USER}/.config && ln -s /home/${CONFIG_USER}/git/boot-dev/nvim /home/${CONFIG_USER}/.config/nvim
mkdir -p /home/${CONFIG_USER}/.config && ln -s /home/${CONFIG_USER}/git/boot-dev/nix/home-manager /home/${CONFIG_USER}/.config/home-manager
mkdir -p /home/${CONFIG_USER}/.config && ln -s /home/${CONFIG_USER}/git/boot-dev/lazygit /home/${CONFIG_USER}/.config/lazygit

# Remove system gnupg prior to installing nix and home-manager to avoid version conflicts
sudo env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a \
  apt-get -yqq \
  -o Dpkg::Options::=--force-confdef \
  -o Dpkg::Options::=--force-confold \
  remove gnupg
sudo env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a \
  apt-get -yqq \
  -o Dpkg::Options::=--force-confdef \
  -o Dpkg::Options::=--force-confold \
  autoremove

# Install nix
curl -L https://nixos.org/nix/install | sh -s -- --no-daemon
sudo chown ${CONFIG_USER}:${CONFIG_USER} /nix/* -R
export PATH=${PATH}:/nix/var/nix/profiles/default/bin:/home/${CONFIG_USER}/.nix-profile/bin

# Configure and install home-manager and run initial home-manager switch
nix-channel --add https://github.com/nixos/nixpkgs/archive/release-26.05.tar.gz nixpkgs
nix-channel --add https://github.com/nix-community/home-manager/archive/release-26.05.tar.gz home-manager
nix-channel --add https://github.com/catppuccin/nix/archive/release-26.05.tar.gz catppuccin
nix-channel --update
cd /home/${CONFIG_USER}/.config/home-manager
cp -p ~/.profile ~/.profile.orig
cp -p ~/.bashrc ~/.bashrc.orig
rm ~/.bashrc ~/.profile
# nix-shell '<home-manager>' -A install

# Link to devenv flake
ln -s /home/${CONFIG_USER}/git/boot-dev/nix/devenv /home/${CONFIG_USER}/devenv

# migrate to flake
# home-manager switch
# install home-manager and switch from flake
# home-manager switch --impure --flake ~/.config/home-manager#devx
nix run github:nix-community/home-manager -- switch --impure --flake ~/.config/home-manager#devx

# Initialize Neovim plugins
echo
echo "Headless initailization of Neovim will commence in 10 seconds."
echo "Initialization will require 2 minutes."
echo "Please stand by..."
echo

# Install any missing plugins and pin every plugin to the commit recorded in
# boot-dev's lazy-lock.json. BOOT_DEV_LAZY_LOCKFILE_READONLY keeps lazy from
# rewriting the lock file while it is still discovering plugin specs.
# The bang makes Lazy wait until restore has finished.
BOOT_DEV_LAZY_LOCKFILE_READONLY=1 nvim --headless "+Lazy! restore" +qa

# Set JetBrains Mono Nerd Font Medium as the GNOME Terminal default font.
# Skipped when GNOME Terminal is unavailable (e.g. inside the container).
if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q org.gnome.Terminal.ProfilesList; then
  profile=$(gsettings get org.gnome.Terminal.ProfilesList default | tr -d "'")
  if [ -n "\$profile" ]; then
    gsettings set "org.gnome.Terminal.Legacy.Profile:/org/gnome/terminal/legacy/profiles:/:\$profile/" use-system-font false
    gsettings set "org.gnome.Terminal.Legacy.Profile:/org/gnome/terminal/legacy/profiles:/:\$profile/" font "JetBrainsMono Nerd Font Medium 12"
  fi
fi

if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q org.gnome.Ptyxis; then
  profile=$(gsettings get org.gnome.Ptyxis default-profile-uuid | tr -d "'")
  if [ -n "\$profile" ]; then
    gsettings set org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/\$profile/ palette "Catppuccin Mocha"
  fi

  gsettings set org.gnome.Ptyxis use-system-font false
  gsettings set org.gnome.Ptyxis font-name "JetBrainsMono Nerd Font Medium 12"
fi

echo
echo
echo "System ready. Logout and log back in to start a clean session."
EOF

# Copy the invoking user's SSH authorized_keys to the configured user so
# the new account can log in with the same keys.
SRC_USER="${SUDO_USER:-$(id -un)}"
SRC_HOME="$(getent passwd "$SRC_USER" | cut -d: -f6 || true)"
DST_HOME="$(getent passwd "$CONFIG_USER" | cut -d: -f6 || true)"
DST_GROUP="$(id -gn "$CONFIG_USER" 2>/dev/null || printf '%s' "$CONFIG_USER")"

if [ -z "$SRC_HOME" ] || [ -z "$DST_HOME" ]; then
  echo "warning: could not resolve home directory; skipping authorized_keys copy." >&2
elif [ ! -f "$SRC_HOME/.ssh/authorized_keys" ]; then
  echo "No ~/.ssh/authorized_keys found for ${SRC_USER}; skipping copy."
elif [ "$SRC_USER" = "$CONFIG_USER" ]; then
  echo "Configured user is ${SRC_USER}; authorized_keys already in place."
else
  sudo install -d -m 0700 -o "$CONFIG_USER" -g "$DST_GROUP" "$DST_HOME/.ssh"
  sudo install -m 0600 -o "$CONFIG_USER" -g "$DST_GROUP" \
    "$SRC_HOME/.ssh/authorized_keys" "$DST_HOME/.ssh/authorized_keys"
  echo "Copied ~/.ssh/authorized_keys from ${SRC_USER} to ${CONFIG_USER}."
fi

cat <<EOF

Next steps
----------
Finish setting up credentials with one of the following, then log out and
back in to start a clean session:

  Restore existing credentials from Keeper:
    dev keeper
    Log in, then restore your tokens.

  Or create new SSH, GPG, and pass credentials:
    ~/git/boot-dev/init/keys-init
EOF
