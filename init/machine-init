#!/bin/sh
# Machine init to enable boot-dev build and execution

sudo apt-get -yqq update
sudo apt-get -yqq upgrade

# Install nala for parallel downloads and updates
# then install base level required packages
sudo apt-get -yqq install nala
sudo nala install locales sudo make curl git unzip slirp4netns uidmap buildah xz-utils neovim gcc direnv starship -y

# Configure certs
# Place any local certs into ~/certs
mkdir ~/certs
# sudo copy ~/certs/*.crt /usr/local/share/ca-certificates/
# sudo update-ca-certificates

# Clone repos for dev config
mkdir /home/${USER}/git
cd /home/${USER}/git

# Boot dev
git clone https://github.com/laminar-code/boot-dev.git

# Download and install nerd fonts
mkdir -p ~/.local/share/fonts
curl -L https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.0/IBMPlexMono.zip -o /tmp/IBMPlexMono.zip
curl -L https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.0/JetBrainsMono.zip -o /tmp/JetBrainsMono.zip
unzip -o /tmp/IBMPlexMono.zip -d ~/.local/share/fonts
unzip -o /tmp/JetBrainsMono.zip -d ~/.local/share/fonts
fc-cache -f
rm /tmp/IBMPlexMono.zip /tmp/JetBrainsMono.zip

# Set up local scripts
mkdir /home/${USER}/bin
ln -s /home/${USER}/git/boot-dev/git/clone              /home/${USER}/bin/clone
ln -s /home/${USER}/git/boot-dev/git/clone-files-only   /home/${USER}/bin/clone-files-only
ln -s /home/${USER}/git/boot-dev/git/switch-origin       /home/${USER}/bin/switch-origin
ln -s /home/${USER}/git/boot-dev/git/current-version     /home/${USER}/bin/current-version
ln -s /home/${USER}/git/boot-dev/git/filter-repo         /home/${USER}/bin/filter-repo
ln -s /home/${USER}/git/boot-dev/git/largest-files       /home/${USER}/bin/largest-files
ln -s /home/${USER}/git/boot-dev/container/docker-ports  /home/${USER}/bin/docker-ports
ln -s /home/${USER}/git/boot-dev/container/labels        /home/${USER}/bin/labels
ln -s /home/${USER}/git/boot-dev/container/label-container /home/${USER}/bin/label-container
ln -s /home/${USER}/git/boot-dev/nix/bin/dev             /home/${USER}/bin/dev
ln -s /home/${USER}/git/boot-dev/nix/bin/init            /home/${USER}/bin/init

# Link base config directories to boot-dev
mkdir -p /home/${USER}/.config && ln -s /home/${USER}/git/boot-dev/nix/config        /home/${USER}/.config/nix
mkdir -p /home/${USER}/.config && ln -s /home/${USER}/git/boot-dev/tmux              /home/${USER}/.config/tmux
mkdir -p /home/${USER}/.config && ln -s /home/${USER}/git/boot-dev/nvim              /home/${USER}/.config/nvim
mkdir -p /home/${USER}/.config && ln -s /home/${USER}/git/boot-dev/nix/home-manager  /home/${USER}/.config/home-manager
mkdir -p /home/${USER}/.config && ln -s /home/${USER}/git/boot-dev/lazygit           /home/${USER}/.config/lazygit

# Install nix
curl -L https://nixos.org/nix/install | sh -s -- --no-daemon
sudo chown ${USER}:${USER} /nix/* -R
export PATH=${PATH}:/nix/var/nix/profiles/default/bin:/home/${USER}/.nix-profile/bin

# Configure and install home-manager and run initial home-manager switch
nix-channel --add https://github.com/nixos/nixpkgs/archive/release-25.05.tar.gz nixpkgs
nix-channel --add https://github.com/nix-community/home-manager/archive/release-25.05.tar.gz home-manager
nix-channel --add https://github.com/catppuccin/nix/archive/release-25.05.tar.gz catppuccin
nix-channel --update
cd /home/${USER}/.config/home-manager
cp -p ~/.profile ~/.profile.orig
cp -p ~/.bashrc ~/.bashrc.orig
rm ~/.bashrc ~/.profile
nix-shell '<home-manager>' -A install

# Link to devenv flake
ln -s /home/$USER/git/boot-dev/nix/devenv /home/$USER/devenv

home-manager switch

# Initialize Neovim plugins
echo
echo "Headless initailization of Neovim will commence in 10 seconds."
echo "Initialization will require 2 minutes."
echo "Please stand by..."
echo

# The bang makes Lazy wait until the sync (install/update/clean) has finished
nvim --headless "+Lazy! sync" +qa

# Set JetBrains Mono Nerd Font Medium as the GNOME Terminal default font.
# Skipped when GNOME Terminal is unavailable (e.g. inside the container).
if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q org.gnome.Terminal.ProfilesList; then
  profile=$(gsettings get org.gnome.Terminal.ProfilesList default | tr -d "'")
  if [ -n "$profile" ]; then
    gsettings set "org.gnome.Terminal.Legacy.Profile:/org/gnome/terminal/legacy/profiles:/:$profile/" use-system-font false
    gsettings set "org.gnome.Terminal.Legacy.Profile:/org/gnome/terminal/legacy/profiles:/:$profile/" font "JetBrainsMono Nerd Font Medium 12"
  fi
fi

if command -v gsettings >/dev/null 2>&1 && gsettings list-schemas 2>/dev/null | grep -q org.gnome.Ptyxis; then
  profile=$(gsettings get org.gnome.Ptyxis default-profile-uuid | tr -d "'")
  if [ -n "$profile" ]; then
    gsettings set org.gnome.Ptyxis.Profile:/org/gnome/Ptyxis/Profiles/$profile/ palette "Catppuccin Mocha"
  fi

  gsettings set org.gnome.Ptyxis use-system-font false
  gsettings set org.gnome.Ptyxis font-name "JetBrainsMono Nerd Font Medium 12"
fi

echo
echo
echo "System ready. Logout and log back in to start a clean session."
